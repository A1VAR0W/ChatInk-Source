# Produccion: este archivo nunca se comparte con Desarrollo.
# Dominio sin https:// ni ruta. Debe apuntar a la IP publica de casa.
APP_DOMAIN=chat.example.com
ACME_EMAIL=admin@example.com

# Solo main publica latest; no uses la etiqueta development en Produccion.
# Incluye los orígenes nativos para Android/iOS además del dominio web.
ALLOWED_ORIGINS=https://chat.example.com,https://localhost,capacitor://localhost

# GHCR convierte el nombre de la imagen a minusculas.
APP_IMAGE=ghcr.io/a1var0w/pictochat:latest
CADDY_IMAGE=caddy:2.11.4-alpine

# Genera uno exclusivo de Produccion con: openssl rand -base64 48
TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Retencion efimera.
ROOM_MAX_AGE_MS=86400000
ROOM_EMPTY_TTL_MS=600000
MAX_FILE_BYTES=26214400
