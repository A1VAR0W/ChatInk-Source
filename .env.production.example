# Plantilla para validar un build de Produccion fuera del servidor.
# El despliegue real usa deploy/.env.production (consulta deploy/.env.production.example).
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
TOKEN_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://chat.example.com
TRUST_PROXY=true
SERVE_CLIENT=true
CLIENT_DIST=apps/client/dist
TEMP_ROOT=tmp/production

SESSION_TTL_MS=43200000
ROOM_TOKEN_TTL_MS=86400000
ROOM_EMPTY_TTL_MS=300000
CLEANUP_INTERVAL_MS=60000
ORPHAN_MAX_AGE_MS=3600000

ROOM_MAX_PARTICIPANTS=24
ROOMS_PER_SESSION=5
MAX_MESSAGES_PER_ROOM=500
MAX_FILE_BYTES=26214400
MAX_FILES_PER_ROOM=40
API_RATE_LIMIT_PER_MINUTE=120
CREATE_ROOM_RATE_LIMIT_PER_HOUR=10
MESSAGE_RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=12
CONNECTION_RATE_LIMIT_PER_MINUTE=20

# Política operativa: actualízala únicamente después de publicar los binarios.
MIN_SUPPORTED_CLIENT_VERSION=0.0.0
LATEST_CLIENT_VERSION=0.0.0
CLIENT_RELEASE_URL=https://github.com/A1VAR0W/ChatInk-Releases/releases

# URLs publicas que se incorporan al cliente web/nativo.
VITE_SERVER_URL=https://chat.example.com
VITE_PUBLIC_APP_URL=https://chat.example.com
VITE_MAX_FILE_BYTES=26214400
VITE_ENABLE_UPDATE_CHECKS=true
VITE_APP_VERSION=
VITE_APP_VERSION_CODE=
VITE_RELEASE_TAG=
VITE_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/A1VAR0W/ChatInk-Releases/main/latest.json
