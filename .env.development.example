# Desarrollo local. Copia este archivo a .env.development si necesitas cambiar los valores por defecto.
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
TOKEN_SECRET=development-only-secret-change-me-now
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
SERVE_CLIENT=false
CLIENT_DIST=apps/client/dist
TEMP_ROOT=tmp/development

# Ciclo de vida reducido para facilitar pruebas locales (milisegundos).
SESSION_TTL_MS=43200000
ROOM_TOKEN_TTL_MS=86400000
ROOM_MAX_AGE_MS=86400000
ROOM_EMPTY_TTL_MS=600000
CLEANUP_INTERVAL_MS=60000
ORPHAN_MAX_AGE_MS=3600000

# Limites de desarrollo.
ROOM_MAX_PARTICIPANTS=24
ROOMS_PER_SESSION=5
MAX_MESSAGES_PER_ROOM=500
MAX_MESSAGE_CHARS=1000
MAX_FILE_BYTES=26214400
MAX_FILES_PER_ROOM=40
API_RATE_LIMIT_PER_MINUTE=120
CREATE_ROOM_RATE_LIMIT_PER_HOUR=10
MESSAGE_RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=12
CONNECTION_RATE_LIMIT_PER_MINUTE=20

# Solo valores publicos; Vite los incorpora al bundle.
VITE_SERVER_URL=
VITE_PUBLIC_APP_URL=http://localhost:5173
VITE_MAX_FILE_BYTES=26214400
VITE_ENABLE_UPDATE_CHECKS=false
# Se dejan vacías para usar la versión canónica local durante desarrollo.
VITE_APP_VERSION=
VITE_APP_VERSION_CODE=
VITE_RELEASE_TAG=
VITE_UPDATE_MANIFEST_URL=
