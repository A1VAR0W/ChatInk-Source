{
  "name": "@pictochat/client",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "assets:generate": "capacitor-assets generate --android --ios --iconBackgroundColor=#f3f1fb --iconBackgroundColorDark=#11101e --splashBackgroundColor=#f3f1fb --splashBackgroundColorDark=#11101e",
    "assets:generate:android": "capacitor-assets generate --android --iconBackgroundColor=#f3f1fb --iconBackgroundColorDark=#11101e --splashBackgroundColor=#f3f1fb --splashBackgroundColorDark=#11101e",
    "assets:generate:ios": "capacitor-assets generate --ios --iconBackgroundColor=#f3f1fb --iconBackgroundColorDark=#11101e --splashBackgroundColor=#f3f1fb --splashBackgroundColorDark=#11101e",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @pictochat/shared",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.0",
    "@ionic/react": "^9.0.0",
    "@pictochat/shared": "0.1.0",
    "ionicons": "^8.0.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
