{
  "name": "@pictochat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @pictochat/shared",
    "test": "vitest run",
    "test:integration": "vitest run src/realtime/realtime.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@pictochat/shared": "0.1.0",
    "argon2": "^0.45.1",
    "fastify": "^5.12.1",
    "file-type": "^22.0.2",
    "jose": "^6.2.9",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.12",
    "vitest": "^4.1.11"
  }
}
