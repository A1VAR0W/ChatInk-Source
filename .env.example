# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
# En produccion usa al menos 32 bytes aleatorios; nunca reutilices este ejemplo.
TOKEN_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,https://localhost,capacitor://localhost
TRUST_PROXY=false
SERVE_CLIENT=false
CLIENT_DIST=apps/client/dist
TEMP_ROOT=

# Ciclo de vida (milisegundos)
SESSION_TTL_MS=43200000
ROOM_TOKEN_TTL_MS=86400000
ROOM_MAX_AGE_MS=86400000
ROOM_EMPTY_TTL_MS=600000
CLEANUP_INTERVAL_MS=60000
ORPHAN_MAX_AGE_MS=3600000

# Limites
ROOM_MAX_PARTICIPANTS=24
ROOMS_PER_SESSION=5
MAX_MESSAGES_PER_ROOM=500
MAX_MESSAGE_CHARS=1000
MAX_FILE_BYTES=26214400
MAX_FILES_PER_ROOM=40
API_RATE_LIMIT_PER_MINUTE=120
CREATE_ROOM_RATE_LIMIT_PER_HOUR=10
MESSAGE_RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=12
CONNECTION_RATE_LIMIT_PER_MINUTE=20

# Cliente (solo valores publicos; se incorporan al bundle)
VITE_SERVER_URL=
VITE_PUBLIC_APP_URL=
VITE_MAX_FILE_BYTES=26214400
